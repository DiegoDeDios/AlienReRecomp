# Generates overrides_table.c: the table of native overrides (native.c) by
# module and address, from the same tools/overrides_*.txt lists the
# recompiler uses. In interpreted builds it also defines each wrapper's
# NAME__orig as "interpret the original function at its address".
#   port_generate_overrides(<output .c> <interpreted: ON/OFF>)
function(port_generate_overrides out interpreted)
  set(decls "")
  set(shims "")
  set(rows "")
  foreach(spec "alien;ALIEN;ALIEN.BIN" "slus;SLUS;SLUS_006.33")
    list(GET spec 0 file)
    list(GET spec 1 prefix)
    list(GET spec 2 module)
    set(list_path ${CMAKE_SOURCE_DIR}/tools/overrides_${file}.txt)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${list_path})
    file(STRINGS ${list_path} lines)
    foreach(line IN LISTS lines)
      if(line MATCHES "^([0-9a-fA-F]+)([ \t]+wrap)?")
        string(TOUPPER "${CMAKE_MATCH_1}" addr)
        set(name ${prefix}_${addr})
        string(APPEND decls "void ${name}(CPU *c);\n")
        string(APPEND rows "    {\"${module}\", 0x${addr}u, ${name}},\n")
        if(CMAKE_MATCH_2 AND interpreted)
          string(APPEND shims "void ${name}__orig(CPU *c) { interp_call(c, 0x${addr}u); }\n")
        endif()
      endif()
    endforeach()
  endforeach()
  set(content "/* Generated by CMake from tools/overrides_*.txt - do not edit. */
#include \"psx.h\"

${decls}
void interp_call(CPU *c, uint32_t addr);
${shims}
const NativeOverride g_native_overrides[] = {
${rows}};
const unsigned g_native_override_count = sizeof g_native_overrides / sizeof g_native_overrides[0];
")
  file(CONFIGURE OUTPUT ${out} CONTENT "${content}" @ONLY)
endfunction()
